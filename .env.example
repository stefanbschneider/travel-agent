# Copy to .env (ignored) and fill your local key.
# Phase 2 LLM client now auto-loads .env for openai/infradeep backends.
# You can still source manually if you want the vars in your shell session:
#   source .env

export INFRADEEP_API_KEY=""

# Optional overrides (only if you need non-default values):
# export INFRADEEP_BASE_URL="https://api.deepinfra.com/v1/openai"
# export INFRADEEP_MODEL="Qwen/Qwen3.6-27B-Instruct"
# export TPC_P2_LLM_BACKEND="infradeep"
# export TPC_P2_LLM_PARSE="1"
