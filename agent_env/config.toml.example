[run]
split = "easy"
# Sandbox/query language: "en" or "zh". The TPC competition data is English, so the
# script's built-in default is "en" and applies to query loading, the environment
# tools, and both commonsense and hard-logic evaluation.
lang = "en"
harness = "opencode"
method = ""
work_dir = ""
tool_python = "UV_CACHE_DIR=/tmp/uv_cache uv run python"
uid = ""
limit = 1
no_run_harness = false
resume = false
plan_file = ""

[opencode]
model = "dashscope/qwen3.6-27b"
timeout = 900
require_output_tags = true
dangerously_skip_permissions = true

# Keep the real config.toml untracked because this may contain a secret.
# Either set api_key here in your local config.toml, or leave it empty and
# export the env var named by api_key_env before running the script.
api_key = ""
api_key_env = "DASHSCOPE_API_KEY"

[opencode.provider]
id = "dashscope"
name = "DashScope"
npm = "@ai-sdk/openai-compatible"
base_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"
tool_call = true

[opencode.provider.model_options]
enable_thinking = false

[codex]
model = "qwen3.6-35b-a3b"
timeout = 900
sandbox = "workspace-write"
output_schema = false
require_output_tags = true
api_key = ""
api_key_env = "OPENAI_API_KEY"

[codex.provider]
id = "openai_api"
name = "OpenAI API"
base_url = "https://api.openai.com/v1"
env_key = "OPENAI_API_KEY"
wire_api = "responses"

[codex.extra_config]
model_reasoning_effort = "low"
model_verbosity = "low"

[deepinfra]
# Optional DeepInfra endpoint settings (OpenAI-compatible wire format).
# Use with local agent_env/config.toml (untracked) + source .env before runs.
model = "Qwen/Qwen3.6-27B-Instruct"
timeout = 900
sandbox = "workspace-write"
output_schema = false
require_output_tags = true
api_key = ""
api_key_env = "DEEPINFRA_API_KEY"

[deepinfra.provider]
id = "deepinfra_api"
name = "DeepInfra API"
base_url = "https://api.deepinfra.com/v1/openai"
env_key = "DEEPINFRA_API_KEY"
wire_api = "responses"

[phase2.llm]
# Phase 2 parser/refinement LLM (optional; deterministic default is backend="none").
# Supported backends: none | fixture | openai | deepinfra
backend = "none"
model = ""
base_url = ""
api_key = ""
api_key_env = "DEEPINFRA_API_KEY"
fixtures_dir = ""
temperature = 0.0
max_tokens = 1024
